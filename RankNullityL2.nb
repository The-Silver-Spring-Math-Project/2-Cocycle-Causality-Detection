In[271]:= ClearAll["Global`*"];

QuandleSet={0,1,2,t,2t,t+1,t+2,2t+1,2t+2}
possibleColoringsAtCrossing=Tuples[QuandleSet,{3}]

$RecursionLimit=100000;
$OutputSizeLimit = 100000;
(*Do[ToExpression[ "validColorings" <> ToString[i], InputForm, Function[x, x = {}] ], {i, 1, 45} ] *)
Do[ToExpression["validColorings" <> ToString[i] <> " = {}"], {i, 1, 85}];

crossTriples = {
  {a26,a1,a2},{a1,a27,a26},{a3,a2,a1},{a1,a4,a3},{a3,a5,a4},{a7,a6,a5},{a6,a7,a8},{a6,a28,a29},{a28,a6,a47},{a7,a8,a9},{a9,a10,a7},{a10,a9,a11},{a12,a11,a10},{a4,a2,a13},{a13,a14,a12},{a14,a15,a19},{a13,a15,a22},{a14,a16,a20},{a13,a16,a21},{a21,a17,a14},{a21,a18,a13},{a22,a17,a20},{a22,a18,a19},{a20,a23,a21},{a20,a24,a22},{a19,a23,a26},{a19,a24,a25},{a29,a28,a30},{a30,a31,a29},{a31,a30,a32},{a32,a33,a31},{a33,a32,a34},{a34,a35,a33},{a35,a36,a40},{a34,a36,a38},{a35,a37,a41},{a34,a37,a39},{a39,a42,a35},{a39,a43,a34},{a38,a42,a41},{a38,a43,a40},{a40,a44,a25},{a41,a44,a39},{a40,a45,a46},{a41,a45,a38},{a48,a67,a47},{a67,a48,a49},{a67,a68,a69},{a68,a67,a3},{a48,a49,a50},{a50,a51,a48},{a51,a50,a52},{a52,a53,a51},{a53,a52,a54},{a54,a55,a53},{a55,a56,a58},{a54,a56,a61},{a55,a57,a59},{a54,a57,a60},{a60,a62,a55},{a60,a63,a54},{a61,a62,a59},{a61,a63,a58},{a58,a64,a46},{a59,a64,a60},{a58,a65,a66},{a59,a65 ,a61},{a69,a68,a70},{a70,a71,a69},{a71,a70, a72},{a72,a73,a71},{a73,a72,a74},{a74,a75,a73},{a75,a76,a78},{a74,a76, a81},{a75,a77,a79},{a74,a77,a80},{a80,a82,a75},{a80,a83,a74},{a81,a82, a79},{a81,a83,a78},{a78,a84,a66},{a79,a84,a80},{a78,a85,a27},{a79,a85, a81}
};

equation[a_,b_,c_]:=(a-t*b -(1-t)*c)

arcRules = Table[
   Symbol["a" <> ToString[i]] ->
     Symbol["x" <> ToString[i]] +
     t*Symbol["y" <> ToString[i]],
   {i, 1, 85}
];

equations=(equation @@@ crossTriples) /. arcRules;

equations=PolynomialRemainder[Expand[#],t^2+1,t,Modulus->3] & /@ equations;

scalarEquations = Flatten[
   ({Coefficient[#, t, 0],
      Coefficient[#, t, 1]} & /@ equations)
];

variables={x1,y1,x2,y2,x3,y3,x4,y4,x5,y5,x6,y6,x7,y7,x8,y8,x9,y9,x10,y10,x11,y11,x12,y12,x13,y13,x14,y14,x15,y15,x16,y16,x17,y17,x18,y18,x19,y19,x20,y20,x21,y21,x22,y22,x23,y23,x24,y24,x25,y25,x26,y26,x27,y27,x28,y28,x29,y29,x30,y30,x31,y31,x32,y32,x33,y33,x34,y34,x35,y35,x36,y36,x37,y37,x38,y38,x39,y39,x40,y40,x41,y41,x42,y42,x43,y43,x44,y44,x45,y45,x46,y46,x47,y47,x48,y48,x49,y49,x50,y50,x51,y51,x52,y52,x53,y53,x54,y54,x55,y55,x56,y56,x57,y57,x58,y58,x59,y59,x60,y60,x61,y61,x62,y62,x63,y63,x64,y64,x65,y65,x66,y66,x67,y67,x68,y68,x69,y69,x70,y70,x71,y71,x72,y72,x73,y73,x74,y74,x75,y75,x76,y76,x77,y77,x78,y78,x79,y79,x80,y80,x81,y81,x82,y82,x83,y83,x84,y84,x85,y85}

nullityMatrix = Normal[CoefficientArrays[scalarEquations, variables][[2]]];

nullityMatrix=Mod[nullityMatrix,3];

RREFnullityMatrix=RowReduce[nullityMatrix, Modulus->3];

Rank=MatrixRank[RREFnullityMatrix, Modulus ->3];

nullity=Length[variables]-Rank

coefficientSum=3^nullity

Print[MatrixForm[nullityMatrix]];

Print[nullity];
Print[coefficientSum];

Print[Dimensions[nullityMatrix]];

