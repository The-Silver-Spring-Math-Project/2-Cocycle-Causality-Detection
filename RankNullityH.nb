In[316]:= QuandleSet={0,1,2,t,2t,t+1,t+2,2t+1,2t+2}
possibleColoringsAtCrossing=Tuples[QuandleSet,{3}]

$RecursionLimit=100000;
$OutputSizeLimit = 100000;
(*Do[ToExpression[ "validColorings" <> ToString[i], InputForm, Function[x, x = {}] ], {i, 1, 45} ] *)
Do[ToExpression["validColorings" <> ToString[i] <> " = {}"], {i, 1, 4}];

crossTriples = {
  {a1,a2,a3},{a4,a3,a2},{a3,a1,a1},{a3,a4,a4}
};

equation[a_,b_,c_]:=(a-t*b -(1-t)*c)

arcRules = Table[
   Symbol["a" <> ToString[i]] ->
     Symbol["x" <> ToString[i]] +
     t*Symbol["y" <> ToString[i]],
   {i, 1, 4}
];

equations=(equation @@@ crossTriples) /. arcRules;

equations=PolynomialRemainder[Expand[#],t^2+1,t,Modulus->3] & /@ equations;

scalarEquations = Flatten[
   ({Coefficient[#, t, 0],
      Coefficient[#, t, 1]} & /@ equations)
];

variables={x1,y1,x2,y2,x3,y3,x4,y4}

nullityMatrix = Normal[CoefficientArrays[scalarEquations, variables][[2]]];

nullityMatrix=Mod[nullityMatrix,3];

RREFnullityMatrix=RowReduce[nullityMatrix, Modulus->3];

Rank=MatrixRank[RREFnullityMatrix, Modulus ->3];

nullity=Length[variables]-Rank

coefficientSum=3^nullity

Print[MatrixForm[nullityMatrix]];

Print[nullity];
Print[coefficientSum];

Print[Dimensions[nullityMatrix]];

