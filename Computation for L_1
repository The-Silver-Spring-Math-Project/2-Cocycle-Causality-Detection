For[i=1,i<=Length[a], i=i+1,matches=Lookup[index,key@@Lookup[a[[i]],arcVariables],{}
];
For[f=1,f<=Length[matches],f=f+1,Sow[Join[a[[i]],matches[[f]]]]
];
]
][[2]];
